<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ohm_odometry</name>
  <version>0.1.0</version>
  <description>Lab 'Kinematics and odometry' on the mecanum-lab simulator: kinematics of a differential
    and a mecanum drive, odometry from wheel encoders (180 minutes, Intelligente Robotik).</description>
  <maintainer email="christian.pfitzner@th-nuernberg.de">Christian Pfitzner</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- The simulator (repository ir-mecanum-lab, package mecanum_lab) is a separate checkout next door and
       deliberately not a depend, as in ohm-localization: ohm_odometry/paths.py finds it there or installed. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
